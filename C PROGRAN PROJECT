#include <stdio.h>
struct Patient
{
    int patient_id;
    char patient_name[50];
    int age;
    char disease[50];
};
struct Patient patients[50];
int patient_count = 0;
void addPatient()
{
    printf("\n===== Add Patient =====\n");

    printf("Enter Patient ID : ");
    scanf("%d", &patients[patient_count].patient_id);

    getchar();

    printf("Enter Patient Name : ");
    fgets(patients[patient_count].patient_name, 50, stdin);

    printf("Enter Age : ");
    scanf("%d", &patients[patient_count].age);

    patient_count++;

    printf("\nPatient Added Successfully!\n");
}
void displayPatients()
{
     if(patient_count == 0)
    {
        printf("\nNo Patient Records Found!\n");
        return;
    }

    printf("\n===== Patient Details =====\n");

    for(int i = 0; i < patient_count; i++)
    {
        printf("\n----- Patient %d -----\n", i + 1);
        printf("Patient ID   : %d\n", patients[i].patient_id);
        printf("Patient Name : %s", patients[i].patient_name);
        printf("Age          : %d\n", patients[i].age);
    }
}
    void searchPatient()
 {
    int id;
    int found = 0;

    printf("\n===== Search Patient =====\n");
    printf("Enter Patient ID : ");
    scanf("%d", &id);

    for(int i = 0; i < patient_count; i++)
    {
        if(patients[i].patient_id == id)
        {
            printf("\nPatient Found!\n");
            printf("Patient ID   : %d\n", patients[i].patient_id);
            printf("Patient Name : %s", patients[i].patient_name);
            printf("Age          : %d\n", patients[i].age);

            found = 1;
            break;
        }
    }
    if(found ==0){
        printf("\nPatient Not Found!\n");
    }
}
    void updatePatient()
{
    int id;
    int found = 0;

    printf("\n===== Update Patient =====\n");
    printf("Enter Patient ID : ");
    scanf("%d", &id);

    for(int i = 0; i < patient_count; i++)
    {
        if(patients[i].patient_id == id)
        {
            getchar();

            printf("Enter New Patient Name : ");
            fgets(patients[i].patient_name, 50, stdin);

            printf("Enter New Age : ");
            scanf("%d", &patients[i].age);

            printf("\nPatient Details Updated Successfully!\n");

            found = 1;
            break;
        }
    }
     if(found ==0){
        printf("\nPatient Not Found!\n");
    }
}
    void deletePatient()
{
    int id;
    int found = 0;

    printf("\n===== Delete Patient =====\n");
    printf("Enter Patient ID : ");
    scanf("%d", &id);

    for(int i = 0; i < patient_count; i++)
    {
        if(patients[i].patient_id == id)
        {
            for(int j = i; j < patient_count - 1; j++)
            {
                patients[j] = patients[j + 1];
            }

            patient_count--;

            printf("\nPatient Deleted Successfully!\n");

            found = 1;
            break;
        }
    }
    if(found ==0){
        printf("\nPatient Not Found!\n");
    }
}
