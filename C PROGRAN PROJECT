void bookAppointment()
{
    int patient_id;
    char date[20];
    char time[20];

    printf("\n===== Book Appointment =====\n");

    printf("Enter Patient ID : ");
    scanf("%d", &patient_id);

    if(patient_id <= 0)
    {
        printf("\nInvalid Patient ID!\n");
        return;
    }

    getchar();

    printf("Enter Appointment Date (DD/MM/YYYY) : ");
    fgets(date, 20, stdin);

    printf("Enter Appointment Time : ");
    fgets(time, 20, stdin);

    printf("\nAppointment Booked Successfully!\n");
}
void viewAppointments()
{
    int patient_id;

    printf("\n===== View Appointment =====\n");

    printf("Enter Patient ID : ");
    scanf("%d", &patient_id);

    if(patient_id <= 0)
    {
        printf("\nInvalid Patient ID!\n");
        return;
    }

    printf("\nAppointment Details\n");
    printf("Patient ID : %d\n", patient_id);
    printf("Date       : 25/07/2026\n");
    printf("Time       : 10:00 AM\n");
}
void calculateBill()
{
    int days;
    float charge_per_day, total_bill;

    printf("\n===== Calculate Bill =====\n");

    printf("Enter Number of Days : ");
    scanf("%d", &days);

    printf("Enter Charge Per Day : ");
    scanf("%f", &charge_per_day);

    total_bill = days * charge_per_day;

    printf("\nTotal Hospital Bill = %.2f\n", total_bill);
}
void dischargePatient()
{
    int patient_id;

    printf("\n===== Discharge Patient =====\n");

    printf("Enter Patient ID : ");
    scanf("%d", &patient_id);

    if(patient_id <= 0)
    {
        printf("\nInvalid Patient ID!\n");
        return;
    }

    printf("\nPatient Discharged Successfully!\n");
}

   
